# Copy to .env and fill in. .env is ignored by Git.

# Local: matches docker-compose.yml. Railway sets its own.
DATABASE_URL=postgres://media_shelf:media_shelf@localhost:5433/media_shelf

# The one login password for the app
APP_PASSWORD=

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# TMDB API Read Access Token (account settings > API)
TMDB_TOKEN=
